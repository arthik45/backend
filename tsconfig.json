{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2016",

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],
    "moduleResolution": "node",

    "esModuleInterop": true,
    "verbatimModuleSyntax": false,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true
  }
}